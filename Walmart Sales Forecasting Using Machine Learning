{"cells":[{"cell_type":"code","source":["# =========================================================\n","# 1. Import Libraries\n","# =========================================================\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.linear_model import LinearRegression\n","from sklearn.ensemble import RandomForestRegressor\n","from sklearn.metrics import mean_absolute_error\n","from xgboost import XGBRegressor\n","\n","plt.style.use(\"seaborn-v0_8\")\n","\n","\n","# =========================================================\n","# 2. Load and Prepare Dataset\n","# =========================================================\n","df = pd.read_csv(\"Walmart.csv\")\n","\n","# Convert date column\n","df[\"Date\"] = pd.to_datetime(df[\"Date\"], dayfirst=True)\n","\n","# Sort by date\n","df = df.sort_values(\"Date\")\n","\n","print(\"Dataset Shape:\", df.shape)\n","df.head()\n","\n","\n","# =========================================================\n","# 3. Overall Sales Trend\n","# =========================================================\n","sales_by_date = df.groupby(\"Date\")[\"Weekly_Sales\"].sum()\n","\n","plt.figure(figsize=(14,6))\n","plt.plot(sales_by_date, color=\"royalblue\", linewidth=2)\n","\n","plt.title(\"Total Walmart Weekly Sales Over Time\", fontsize=16)\n","plt.xlabel(\"Date\")\n","plt.ylabel(\"Total Weekly Sales ($)\")\n","plt.grid(True, linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 4. Total Sales by Store\n","# =========================================================\n","store_sales = df.groupby(\"Store\")[\"Weekly_Sales\"].sum()\n","\n","plt.figure(figsize=(14,6))\n","store_sales.plot(kind=\"bar\", color=\"teal\")\n","\n","plt.title(\"Total Sales by Store\", fontsize=16)\n","plt.xlabel(\"Store ID\")\n","plt.ylabel(\"Total Sales ($)\")\n","plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 5. Holiday vs Non-Holiday Sales\n","# =========================================================\n","holiday_sales = df.groupby(\"Holiday_Flag\")[\"Weekly_Sales\"].mean()\n","\n","plt.figure(figsize=(8,5))\n","holiday_sales.plot(kind=\"bar\", color=[\"gray\", \"orange\"])\n","\n","plt.title(\"Average Weekly Sales: Holiday vs Non-Holiday Weeks\")\n","plt.xlabel(\"Holiday Flag (0 = No Holiday, 1 = Holiday)\")\n","plt.ylabel(\"Average Weekly Sales ($)\")\n","plt.xticks(rotation=0)\n","plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 6. Monthly Sales Seasonality\n","# =========================================================\n","df[\"Month\"] = df[\"Date\"].dt.month\n","monthly_sales = df.groupby(\"Month\")[\"Weekly_Sales\"].mean()\n","\n","plt.figure(figsize=(12,6))\n","plt.plot(monthly_sales, marker=\"o\", linewidth=2, color=\"purple\")\n","\n","plt.title(\"Average Weekly Sales by Month (Seasonality)\")\n","plt.xlabel(\"Month\")\n","plt.ylabel(\"Average Weekly Sales ($)\")\n","plt.grid(True, linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 7. Feature Engineering\n","# =========================================================\n","df = df.sort_values([\"Store\", \"Date\"])\n","\n","df[\"lag_1\"] = df.groupby(\"Store\")[\"Weekly_Sales\"].shift(1)\n","df[\"lag_4\"] = df.groupby(\"Store\")[\"Weekly_Sales\"].shift(4)\n","df[\"lag_12\"] = df.groupby(\"Store\")[\"Weekly_Sales\"].shift(12)\n","\n","df[\"rolling_mean_4\"] = (\n","    df.groupby(\"Store\")[\"Weekly_Sales\"]\n","    .rolling(window=4)\n","    .mean()\n","    .reset_index(0, drop=True)\n",")\n","\n","# Remove rows with missing lag values\n","df = df.dropna()\n","\n","print(\"Dataset Shape After Feature Engineering:\", df.shape)\n","\n","\n","# =========================================================\n","# 8. Feature Correlation Analysis\n","# =========================================================\n","plt.figure(figsize=(10,8))\n","\n","corr = df[\n","    [\n","        \"Weekly_Sales\",\n","        \"Temperature\",\n","        \"Fuel_Price\",\n","        \"CPI\",\n","        \"Unemployment\"\n","    ]\n","].corr()\n","\n","sns.heatmap(corr, annot=True, cmap=\"coolwarm\")\n","\n","plt.title(\"Correlation Between Economic Factors and Sales\")\n","plt.show()\n","\n","\n","# =========================================================\n","# 9. Define Features and Target\n","# =========================================================\n","X = df[\n","    [\n","        \"lag_1\",\n","        \"lag_4\",\n","        \"lag_12\",\n","        \"rolling_mean_4\",\n","        \"Holiday_Flag\",\n","        \"Temperature\",\n","        \"Fuel_Price\",\n","        \"CPI\",\n","        \"Unemployment\"\n","    ]\n","]\n","\n","y = df[\"Weekly_Sales\"]\n","\n","\n","# =========================================================\n","# 10. Train-Test Split (Time-Based)\n","# =========================================================\n","train_size = int(len(df) * 0.8)\n","\n","X_train = X[:train_size]\n","X_test = X[train_size:]\n","\n","y_train = y[:train_size]\n","y_test = y[train_size:]\n","\n","\n","# =========================================================\n","# 11. Linear Regression Model\n","# =========================================================\n","lr_model = LinearRegression()\n","lr_model.fit(X_train, y_train)\n","\n","lr_predictions = lr_model.predict(X_test)\n","\n","lr_mae = mean_absolute_error(y_test, lr_predictions)\n","\n","print(f\"Linear Regression MAE: ${lr_mae:,.2f}\")\n","\n","\n","# =========================================================\n","# 12. Random Forest Model\n","# =========================================================\n","rf_model = RandomForestRegressor(\n","    n_estimators=200,\n","    random_state=42\n",")\n","\n","rf_model.fit(X_train, y_train)\n","\n","rf_predictions = rf_model.predict(X_test)\n","\n","rf_mae = mean_absolute_error(y_test, rf_predictions)\n","\n","print(\"Random Forest MAE:\", rf_mae)\n","\n","plt.figure(figsize=(14,6))\n","plt.plot(y_test.values[:200], label=\"Actual Sales\", linewidth=2)\n","plt.plot(rf_predictions[:200], label=\"Random Forest Predictions\", linewidth=2)\n","\n","plt.title(\"Random Forest: Actual vs Predicted Sales\")\n","plt.xlabel(\"Time Index\")\n","plt.ylabel(\"Weekly Sales ($)\")\n","plt.legend()\n","plt.grid(True, linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 13. Feature Importance Analysis\n","# =========================================================\n","feature_importance = pd.Series(\n","    rf_model.feature_importances_,\n","    index=X_train.columns\n",").sort_values(ascending=False)\n","\n","print(feature_importance)\n","\n","plt.figure(figsize=(10,6))\n","feature_importance.plot(kind=\"bar\", color=\"darkorange\")\n","\n","plt.title(\"Feature Importance (Random Forest)\")\n","plt.xlabel(\"Features\")\n","plt.ylabel(\"Importance Score\")\n","plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 14. Forecast Future 12 Weeks\n","# =========================================================\n","future_steps = 12\n","last_data = X.tail(1).copy()\n","\n","future_predictions = []\n","\n","for _ in range(future_steps):\n","\n","    next_pred = rf_model.predict(last_data)[0]\n","    future_predictions.append(next_pred)\n","\n","    last_data[\"lag_12\"] = last_data[\"lag_4\"]\n","    last_data[\"lag_4\"] = last_data[\"lag_1\"]\n","    last_data[\"lag_1\"] = next_pred\n","\n","plt.figure(figsize=(12,6))\n","\n","plt.plot(y.tail(100).values, label=\"Recent Sales\")\n","plt.plot(range(100,112), future_predictions, label=\"Forecast\", linewidth=3)\n","\n","plt.title(\"Future Sales Forecast (Next 12 Weeks)\")\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"Weekly Sales\")\n","plt.legend()\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 15. XGBoost Model\n","# =========================================================\n","xgb_model = XGBRegressor(\n","    n_estimators=600,\n","    learning_rate=0.03,\n","    max_depth=4,\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","    random_state=42\n",")\n","\n","xgb_model.fit(X_train, y_train)\n","\n","xgb_predictions = xgb_model.predict(X_test)\n","\n","xgb_mae = mean_absolute_error(y_test, xgb_predictions)\n","\n","print(\"XGBoost MAE:\", xgb_mae)\n","\n","plt.figure(figsize=(14,6))\n","\n","plt.plot(y_test.values[:200], label=\"Actual Sales\", linewidth=2)\n","plt.plot(xgb_predictions[:200], label=\"XGBoost Predictions\", linewidth=2)\n","\n","plt.title(\"XGBoost: Actual vs Predicted Sales\")\n","plt.xlabel(\"Time Index\")\n","plt.ylabel(\"Weekly Sales ($)\")\n","plt.legend()\n","plt.grid(True, linestyle=\"--\", alpha=0.6)\n","\n","plt.show()\n","\n","\n","# =========================================================\n","# 16. Final Model Comparison\n","# =========================================================\n","\n","print(results)\n","print(\"\\nModel Comparison\")\n","print(\"-------------------\")\n","print(\"Linear Regression MAE:\", lr_mae)\n","print(\"Random Forest MAE:\", rf_mae)\n","print(\"XGBoost MAE:\", xgb_mae)"],"metadata":{"id":"2154mLda1ucW","executionInfo":{"status":"ok","timestamp":1773172109755,"user_tz":-330,"elapsed":15846,"user":{"displayName":"","userId":""}},"outputId":"a1cebb09-de70-4fcc-ba88-43f2d984e49b","colab":{"base_uri":"https://localhost:8080/","height":1000}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset Shape: (6435, 8)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image